      count = 0;
   }
   Student() {
      count++;
   }
   Student(int currAge) {
      this.age = currAge;
      count++;
   }
   Student(int currAge, String currName) {
      this.name = currName;
      this.age = currAge;
      count++;
   }
 
   Student(String currName) {
      this.name = currName;
      count++;
   }
   Student(Student s) {
      this.name = s.name;
      this.age = s.age;
      count++;
   }
}
